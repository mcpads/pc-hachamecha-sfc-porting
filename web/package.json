{
  "name": "hachamecha-web-converter",
  "private": true,
  "type": "module",
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  },
  "scripts": {
    "format": "prettier --write \"*.mjs\" \"runtime/*.mjs\" \"*.css\" \"*.html\" package.json",
    "format:check": "prettier --check \"*.mjs\" \"runtime/*.mjs\" \"*.css\" \"*.html\" package.json"
  }
}
